{"version":3,"kind":"Article","sha256":"0b9c6b1d6700dd3edebf65b6e585ff43b7dbd3aff8c0e94095ee9c88ca89f2fa","slug":"site","location":"/docs/site.md","dependencies":[],"frontmatter":{"title":"Study site","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Lukas Hörtnagl","given":"Lukas","family":"Hörtnagl"},"name":"Lukas Hörtnagl","email":"lukas.hoertnagl@usys.ethz.ch","affiliations":["ETH Zürich"],"id":"contributors-dev\\manuscripts\\ms-timelag-comparison\\myst-generated-uid-0","corresponding":true}],"affiliations":[{"id":"ETH Zürich","name":"ETH Zürich"}],"exports":[{"format":"md","filename":"site.md","url":"/ms-timelag-comparison/build/site-fb379d4cf997bd85976213bc5aecc318.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The flux measurements come from ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DCfXGGuB38"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Chamau (CH-Cha)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"B9xExUQcfr"}],"key":"y60ImWG4do"},{"type":"text","value":", an intensively managed\ngrassland in the pre-alpine valley bottom near Zug, Switzerland. The eddy\ncovariance tower sits at 47°12′36.8″ N, 8°24′38.3″ E (47.210227, 8.410645),\nabout 393 m above sea level. Mean annual temperature is 10.0 °C (2006 to 2024) and mean annual\nprecipitation is about 1134 mm.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nT5YFLSyx3"}],"key":"fPntpr2Irt"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"The grassland is a mixture of Italian ryegrass and white clover grown mainly for\nsilage, cut roughly six times a year, with occasional spring and fall grazing by\nsheep and cattle. The sward is renewed every 6 to 7 years by ploughing. The soil\nis a Cambisol/Gleysol on tertiary molasse with postglacial deposits from the\nReuss glacier, pH 5.3 in the top 10 cm.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"rQFxBcjV76"}],"key":"RFahobgdaU"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Eddy covariance flux measurements started in July 2005 and cover net ecosystem\nexchange, evapotranspiration, sensible heat, and the greenhouse gases CH₄ and\nN₂O. Chamau is one of three grassland sites in the Swiss FluxNet network.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"pwH48FXbcg"}],"key":"PPPuyn50VE"},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Further information","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"mF1TYpQiqa"}],"identifier":"further-information","label":"Further information","html_id":"further-information","implicit":true,"key":"FYgxJ96dIZ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Swiss FluxNet site info: ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"CMaEDLNFqo"},{"type":"link","url":"https://www.swissfluxnet.ethz.ch/index.php/sites/site-info-ch-cha/","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"https://​www​.swissfluxnet​.ethz​.ch​/index​.php​/sites​/site​-info​-ch​-cha/","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"XF9TmXGyBL"}],"urlSource":"https:/