  return m.group(1) if m else \"\"\n\n\ndef folder_table(folder, pattern=\"*\"):\n    \"\"\"One row per file in `folder` matching `pattern`: name, scenario, size.\"\"\"\n    rows = [\n        {\"file\": f.name, \"scenario\": scenario_of(f.name),\n         \"size\": human_size(f.stat().st_size)}\n        for f in sorted(Path(folder).glob(pattern)) if f.is_file()\n    ]\n    return pd.DataFrame(rows)","key":"zE9PCMw07I"},{"type":"outputs","id":"OrSxXf_IwCkeDRUqGO8U4","children":[],"key":"kHdvE4aDvw"}],"key":"PJpwoJvvJT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"EddyPro flux output (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i6r2LKvKj4"},{"type":"inlineCode","value":"00-eddypro_fluxes_level-1/","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JLxEm6NKaz"},{"type":"text","value":")","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ec4kKunkpV"}],"identifier":"eddypro-flux-output-00-eddypro-fluxes-level-1","label":"EddyPro flux output (00-eddypro_fluxes_level-1/)","html_id":"eddypro-flux-output-00-eddypro-fluxes-level-1","implicit":true,"key":"Dgunbfb7iC"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"One FLUXNET-format CSV per scenario (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"h8JlQ4lJyD"},{"type":"inlineCode","value":"*-1","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lHr9dncyWb"},{"type":"text","value":" to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FPTcylKMbO"},{"type":"inlineCode","value":"*-4","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Pq4J6atyQu"},{"type":"text","value":"); the PWB scenario\n(","position":{