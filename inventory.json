/jpeg\",\n        \".gif\": \"image/gif\", \".svg\": \"image/svg+xml\"}\n\nimages = sorted(p for ext in EXTS for p in FIGDIR.glob(ext))\nprint(f\"Found {len(images)} figure(s) in {FIGDIR}\")\n\ncards = []\nfor p in images:\n    b64 = base64.b64encode(p.read_bytes()).decode()\n    mime = MIME.get(p.suffix.lower(), \"image/png\")\n    cards.append(\n        '<figure style=\"margin:0\">'\n        f'<img src=\"data:{mime};base64,{b64}\" '\n        'style=\"width:100%;height:auto;border:1px solid #ccc;border-radius:4px\"/>'\n        f'<figcaption style=\"font-size:0.8em;text-align:center;word-break:break-all\">{p.name}</figcaption>'\n        '</figure>'\n    )\n\nif cards:\n    grid = (\n        '<div style=\"display:grid;'\n        'grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem\">'\n        + \"\".join(cards) + \"</div>\"\n    )\n    display(HTML(grid))\nelse:\n    print(\"No figures found yet. Run the plotting notebooks first.\")","key":"z7pVFV5qyN"},{"type":"outputs","id":"fXYAEGunWK_Ptc5_dLgMZ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 8 figure(s) in ..\\figures\n"},"children":[],"key":"Z6FJK2VrQx"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"02c79691c89ef63c0c5f1f332f0058af","path":"/ms-timelag-comparison/build/02c79691c89ef63c0c5f1f332f0058af.html"}}},"children":[],"key":"xGgz4KADE6"}],"key":"IRoF8RlaOV"}],"key":"vyYogKPYj6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Runtime","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"E7ZIq1tpjW"}],"identifier":"runtime","label":"Runtime","html_id":"runtime","implicit":true,"key":"EOnrXjNTJb"}],"key":"V