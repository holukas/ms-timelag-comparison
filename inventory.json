0Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"EXTS = (\"*.png\", \"*.jpg\", \"*.jpeg\", \"*.gif\", \"*.svg\")\nMIME = {\".png\": \"image/png\", \".jpg\": \"image/jpeg\", \".jpeg\": \"image/jpeg\",\n        \".gif\": \"image/gif\", \".svg\": \"image/svg+xml\"}\n\nimages = sorted(p for ext in EXTS for p in FIGDIR.glob(ext))\nprint(f\"Found {len(images)} figure(s) in {FIGDIR}\")\n\ncards = []\nfor p in images:\n    b64 = base64.b64encode(p.read_bytes()).decode()\n    mime = MIME.get(p.suffix.lower(), \"image/png\")\n    cards.append(\n        '<figure style=\"margin:0\">'\n        f'<img src=\"data:{mime};base64,{b64}\" '\n        'style=\"width:100%;height:auto;border:1px solid #ccc;border-radius:4px\"/>'\n        f'<figcaption style=\"font-size:0.8em;text-align:center;word-break:break-all\">{p.name}</figcaption>'\n        '</figure>'\n    )\n\nif cards:\n    grid = (\n        '<div style=\"display:grid;'\n        'grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1rem\">'\n        + \"\".join(cards) + \"</div>\"\n    )\n    display(HTML(grid))\nelse:\n    print(\"No figures found yet. Run the plotting notebooks first.\")","key":"xXjhnTmOkN"},{"type":"outputs","id":"BgCWBrz7U2tbQBrdfpm47","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 8 figure(s) in ..\\figures\n"},"children":[],"key":"DUK6FFLtaG"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<IPython.core.display.HTML object>","content_type":"text/plain"},"text/html":{"content_type":"text/html","hash":"47424a6503cda61671bdf1860a3d38c2","path":"/ms-timelag-comparison/build/47424a6503cda61671bdf1860a3d38c2.html"}}},"children":[],"key":"BbvjN8Jrnd"}],"key":"iwaKHkfTtR"}],"key":"kALG15QmRs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text