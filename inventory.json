  return m.group(1) if m else \"\"\n\n\ndef folder_table(folder, pattern=\"*\"):\n    \"\"\"One row per file in `folder` matching `pattern`: name, scenario, size.\"\"\"\n    rows = [\n        {\"file\": f.name, \"scenario\": scenario_of(f.name),\n         \"size\": human_size(f.stat().st_size)}\n        for f in sorted(Path(folder).glob(pattern)) if f.is_file()\n    ]\n    return pd.DataFrame(rows)","key":"sn5Z1cx2BP"},{"type":"outputs","id":"2I_XMN9Y6VECWLtS3xq7F","children":[],"key":"A6oSrRhBDn"}],"key":"onqidchLKu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"EddyPro flux output (","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DRicQ0coY0"},{"type":"inlineCode","value":"00-eddypro_fluxes_level-1/","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jMBicu5Ycj"},{"type":"text","value":")","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rDphS1djTb"}],"identifier":"eddypro-flux-output-00-eddypro-fluxes-level-1","label":"EddyPro flux output (00-eddypro_fluxes_level-1/)","html_id":"eddypro-flux-output-00-eddypro-fluxes-level-1","implicit":true,"key":"WOmwBGunzN"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"One FLUXNET-format CSV per scenario (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RpUAS5piSH"},{"type":"inlineCode","value":"*-1","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qXL3EzMlJ0"},{"type":"text","value":" to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VneGjMFB0w"},{"type":"inlineCode","value":"*-4","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xMWfHmEOPu"},{"type":"text","value":"); the PWB scenario\n(","position":{