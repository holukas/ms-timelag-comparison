h(\"../data/01-eddypro_fluxes_level-1_parquet\")\nOUTDIR.mkdir(parents=True, exist_ok=True)\n\n# Discover the input CSVs. Each filename is prefixed with its scenario code\n# (e.g. 'LGR-1_eddypro_..._adv.csv', 'QCL-4_2020_..._adv.csv').\ncsv_files = sorted(INDIR.glob(\"*_adv.csv\"))\nprint(f\"Found {len(csv_files)} flux file(s):\")\nfor f in csv_files:\n    print(f\"  {f.name}\")","key":"kakNt8Thn3"},{"type":"outputs","id":"vKkSO6ybwWyl_AEeBEiRl","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 8 flux file(s):\n  LGR-1_eddypro_LGR-1_FR-20260619-164852_fluxnet_2026-06-20T073939_adv.csv\n  LGR-2_eddypro_LGR-2_FR-20260615-140834_fluxnet_2026-06-16T050657_adv.csv\n  LGR-3_eddypro_LGR-3_FR-20260615-140917_fluxnet_2026-06-16T035745_adv.csv\n  LGR-4_2021_2_2022_1_LGR_eddypro_CH-CHA_FR-20240809-181345_fluxnet_2024-08-10T185331_adv.csv\n  QCL-1_eddypro_QCL-1_FR-20260619-164952_fluxnet_2026-06-20T101745_adv.csv\n  QCL-2_eddypro_QCL-2_FR-20260615-140229_fluxnet_2026-06-16T073700_adv.csv\n  QCL-3_eddypro_QCL-3_FR-20260615-140311_fluxnet_2026-06-16T060134_adv.csv\n  QCL-4_2020_4_5_2021_1_QCL_eddypro_CH-CHA_FR-20240809-181351_fluxnet_2024-08-10T220247_adv.csv\n"},"children":[],"key":"MV6jy0Z7L0"}],"key":"pUibub4M46"}],"key":"GJUQ70vpka"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Version codes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L2tG9nYRXx"}],"identifier":"version-codes","label":"Version codes","html_id":"version-codes","implicit":true,"key":"vbWjcYTyUL"}],"key":"jzYAUqJd11"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:04:09.105381Z","start_time":"2026-06-22T14:04:09.070331600Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def version_code(filename: str) -> str:\n    \"\"\"Extract the scenario code (e.g. 'LGR-1', 'QCL-4') from a filename.\n\n    The code is the leading token of the filename, before the first underscore.\n    \"\"\"\n    match = re.match(r\"([A-Z]+-\\d+)_\", filename)\n    if not match:\n        raise ValueError(f\"Could not extract a version code from: {filename}\")\n    return match.group(1)\n\n\n# Map each input file to its version code (the output Parquet name).\nfor f in csv_files:\n    print(f\"{version_code(f.name):>8}  <-  {f.name}\")","key":"tNftO50XtZ"},{"type":"outputs","id":"9uRDRdlvErdekpeDLiG_-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"   LGR-1  <-  LGR-1_eddypro_LGR-1_FR-20260619-164852_fluxnet_2026-06-20T073939_adv.csv\n   LGR-2  <-  LGR-2_eddypro_LGR-2_FR-20260615-140834_fluxnet_2026-06-16T050657_adv.csv\n   LGR-3  <-  LGR-3_eddypro_LGR-3_FR-20260615-140917_fluxnet_2026-06-16T035745_adv.csv\n   LGR-4  <-  LGR-4_2021_2_2022_1_LGR_eddypro_CH-CHA_FR-20240809-181345_fluxnet_2024-08-10T185331_adv.csv\n   QCL-1  <-  QCL-1_eddypro_QCL-1_FR-20260619-164952_fluxnet_2026-06-20T101745_adv.csv\n   QCL-2  <-  QCL-2_eddypro_QCL-2_FR-20260615-140229_fluxnet_2026-06-16T073700_adv.csv\n   QCL-3  <-  QCL-3_eddypro_QCL-3_FR-20260615-140311_fluxnet_2026-06-16T060134_adv.csv\n   QCL-4  <-  QCL-4_2020_4_5_2021_1_QCL_eddypro_CH-CHA_FR-20240809-181351_fluxnet_2024-08-10T220247_adv.csv\n"},"children":[],"key":"lScfrk4PX5"}],"key":"mJ5qbIjmFe"}],"key":"bxCtekvckK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read each CSV and save as Parquet","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kcMirtHdM7"}],"identifier":"read-each-csv-and-save-as-parquet","label":"Read each CSV and save as Parquet","html_id":"read-each-csv-and-save-as-parquet","implicit":true,"key":"eQCTlVIj4q"},{"type":"paragraph","position":{"st