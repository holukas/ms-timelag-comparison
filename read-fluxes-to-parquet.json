second == 0)\n    n_off = int((~on_grid).sum())\n    df = df[on_grid]\n\n    # The PWB timestamp is the chunk START time; name the index so diive's\n    # load_parquet accepts it.\n    df.index.name = \"TIMESTAMP_START\"\n    print(f\"  {code}: {df.shape[0]} rows x {df.shape[1]} cols ({n_off} off-grid chunks dropped)\")\n    filepath = save_parquet(filename=f\"{code}_pwb_tlag\", data=df, outpath=str(PWB_OUTDIR))\n    pwb_saved[code] = filepath","key":"l9dioKro51"},{"type":"outputs","id":"NaLFRAgxZxDZW3txcnI9U","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 2 PWB summary file(s):\n  LGR-5: 7805 rows x 62 cols (15 off-grid chunks dropped)\n"},"children":[],"key":"SIGjBSI8gj"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"  \u001b[36m>\u001b[0m Saved file ..\\data\\01-pwb_tlag_summary_parquet\\LGR-5_pwb_tlag.parquet (0.081 seconds).\n","content_type":"text/plain"},"text/html":{"content":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\">  <span style=\"color: #008080; text-decoration-color: #008080\">&gt;</span> Saved file ..\\data\\01-pwb_tlag_summary_parquet\\LGR-5_pwb_tlag.parquet (0.081 seconds).\n</pre>\n","content_type":"text/html"}}},"children":[],"key":"dvKTU3QTij"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  QCL-5: 9520 rows x 62 cols (8 off-grid chunks dropped)\n"},"children":[],"key":"Aw877rhApx"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"  \u001b[36m>\u001b[0m Saved file ..\\data\\01-pwb_tlag_summary_parquet\\QCL-5_pwb_tlag.parquet (0.079 seconds).\n","content_type":"text/plain"},"text/html":{"content":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\">  <span style=\"color