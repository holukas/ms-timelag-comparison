key":"kuQf6Ibpp5"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:34.586535200Z","start_time":"2026-06-22T14:58:34.530808200Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nfrom diive.core.io.files import load_parquet, save_parquet\n\nNB_START = datetime.now()  # notebook start time (reported in the last cell)","key":"mMQhzub97p"},{"type":"outputs","id":"FfVw3zFzA0D1QvTizBLVP","children":[],"key":"UVlvIG4qkQ"}],"key":"RgwYfH2h6A"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Select columns","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DLObBU3Yz0"}],"identifier":"select-columns","label":"Select columns","html_id":"select-columns","implicit":true,"key":"uwFudfYa1F"}],"key":"zuJScjLE8x"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:34.624174Z","start_time":"2026-06-22T14:58:34.587534800Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Columns to keep in each subset. Edit this list as the analysis requires.\nKEEP_COLS = [\n    # Fluxes\n    \"FN2O\",\n    \"FCH4\",\n    # N2O time-lag diagnostics\n    \"N2O_TLAG_USED\",\n    # CH4 time-lag diagnostics\n    \"CH4_TLAG_USED\",\n    # Potential shortwave radiation, for splitting fluxes into daytime\n    # (SW_IN_POT > 0) and nighttime (SW_IN_POT == 0) later on.\n    \"SW_IN_POT\",\n]\nprint(f\"{len(KEEP_COLS)} columns requested.\")","key":"kcXnH5v1HR"},{"type":"outputs","id":"FvmqXbl5LuMi-bXPjtETU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"5 columns requested.\n"},"children":[],"key":"CY7ThFLDNw"}],"key":"eqDUcforH1"}],"key":"JGRpty9h3F"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Configuration","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FzPeE9DajC"}],"identifier":"configuration","label":"Configuration","html_id":"configuration","implicit":true,"key":"kToIDTnppL"}],"key":"Q22DdFgLhS"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:34.663627900Z","start_time":"2026-06-22T14:58:34.625172400Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Input / output folders (relative to the notebooks/ directory).\nINDIR = Path(\"../data/01-eddypro_fluxes_level-1_parquet\")\nOUTDIR = Path(\"../data/02-eddypro_fluxes_level-1_parquet_subsets\")\nOUTDIR.mkdir(parents=True, exist_ok=True)\n\n# This analysis uses only one year; rows outside it are dropped from the subsets.\nYEAR = 2021\n\n# Discover the input Parquet files.\nparquet_files = sorted(INDIR.glob(\"*.parquet\"))\nprint(f\"Found {len(parquet_files)} Parquet file(s):\")\nfor f in parquet_files:\n    print(f\"  {f.name}\")","key":"h1n27OnrFY"},{"type":"outputs","id":"Vu5Z_yraZNB06MVbalS8x","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 8 Parquet file(s):\n  LGR-1.parquet\n  LGR-2.parquet\n  LGR-3.parquet\n  LGR-4.parquet\n  QCL-1.parquet\n  QCL-2.parquet\n  QCL-3.parquet\n  QCL-4.parquet\n"},"children":[],"key":"dGRXGT0pSn"}],"key":"fRg25UQre3"}],"key":"YcZcVKwQAs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subset each file and save","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SAIHuYEdq2"}],"identifier":"subset-each-file-and-save","label":"Subset each file and save","html_id":"subset-each-file-and-save","implicit":true,"key":"K4xrBh7GMY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For each version: load the full table, keep ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"M3Q57WZleJ"},{"type":"inlineCode","value":"KEEP_COLS","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Zbdy58poWt"},{"type":"text","value":" (preserving the\ntimestamp index), warn about any requested columns that are absent, and save the\nsubset under the same version-code filename.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"U16AGn3fdZ"}],"key":"KN3Mn67RyR"}],"key":"OAQUsX5JPg"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:35.803725400Z","start_time":"2026-06-22T14:58:34.665170600Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"saved = {}\nfor f in parquet_files:\n    code = f.stem  # version code, e.g. 'LGR-1'\n    print(f\"\\n=== {code} ===\")\n\n    df = load_parquet(filepath=str(f))\n\n    # Keep only the analysis year.\n    df = df.loc[df.index.year == YEAR]\n\n    present = [c for c in KEEP_COLS if c in df.columns]\n    missing = [c for c in KEEP_COLS if c not in df.columns]\n    if missing:\n        print(f\"  WARNING: {len(missing)} requested column(s) not found: {missing}\")\n\n    subset = df[present]\n    print(f\"  kept {subset.shape[1]} / {len(KEEP_COLS)} columns, \"\n          f\"{subset.shape[0]} rows in {YEAR}\")\n\n    filepath = save_parquet(filename=code, data=subset, outpath=str(OUTDIR))\n    saved[code] = filepath","key":"iDz7IupuXo"},{"type":"outputs","id":"FFuyIkySIRSMeLixU2Fsj","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n=== LGR-1 ===\n"},"children":[],"key":"VSQSXylsST"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"  \u001b[36m>\u001b[0m Loaded .parquet file 