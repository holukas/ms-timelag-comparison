key":"UPvsNXT1Xj"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:34.586535200Z","start_time":"2026-06-22T14:58:34.530808200Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nfrom diive.core.io.files import load_parquet, save_parquet\n\nNB_START = datetime.now()  # notebook start time (reported in the last cell)","key":"Sb96vYduu4"},{"type":"outputs","id":"P04VVIOi4fb177zi7SZlD","children":[],"key":"NvGrdsoeMI"}],"key":"VSfNhBGrPC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Select columns","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m4GFYsqj1C"}],"identifier":"select-columns","label":"Select columns","html_id":"select-columns","implicit":true,"key":"C61EvBpYU6"}],"key":"rZALQLMrEM"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:34.624174Z","start_time":"2026-06-22T14:58:34.587534800Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Columns to keep in each subset. Edit this list as the analysis requires.\nKEEP_COLS = [\n    # Fluxes\n    \"FN2O\",\n    \"FCH4\",\n    # N2O time-lag diagnostics\n    \"N2O_TLAG_USED\",\n    # CH4 time-lag diagnostics\n    \"CH4_TLAG_USED\",\n    # Potential shortwave radiation, for splitting fluxes into daytime\n    # (SW_IN_POT > 0) and nighttime (SW_IN_POT == 0) later on.\n    \"SW_IN_POT\",\n]\nprint(f\"{len(KEEP_COLS)} columns requested.\")","key":"kYn3EC2PaR"},{"type":"outputs","id":"bq_s7AsRTsGkgr66pfBTb","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"5 columns requested.\n"},"children":[],"key":"pXTs01fy3Z"}],"key":"gKOvZyK5Tv"}],"key":"yjmjc9VaqC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Configuration","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hT65TT7JDw"}],"identifier":"configuration","label":"Configuration","html_id":"configuration","implicit":true,"key":"hKk0LZxGDg"}],"key":"SWu1ouhMwp"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:34.663627900Z","start_time":"2026-06-22T14:58:34.625172400Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Input / output folders (relative to the notebooks/ directory).\nINDIR = Path(\"../data/01-eddypro_fluxes_level-1_parquet\")\nOUTDIR = Path(\"../data/02-eddypro_fluxes_level-1_parquet_subsets\")\nOUTDIR.mkdir(parents=True, exist_ok=True)\n\n# This analysis uses only one year; rows outside it are dropped from the subsets.\nYEAR = 2021\n\n# Discover the input Parquet files.\nparquet_files = sorted(INDIR.glob(\"*.parquet\"))\nprint(f\"Found {len(parquet_files)} Parquet file(s):\")\nfor f in parquet_files:\n    print(f\"  {f.name}\")","key":"iuF2zwzYrD"},{"type":"outputs","id":"30neJZnMfTiCHP8qlAzJD","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 8 Parquet file(s):\n  LGR-1.parquet\n  LGR-2.parquet\n  LGR-3.parquet\n  LGR-4.parquet\n  QCL-1.parquet\n  QCL-2.parquet\n  QCL-3.parquet\n  QCL-4.parquet\n"},"children":[],"key":"QU8JXdEWgo"}],"key":"hWN7pCEbtZ"}],"key":"uTdoyz8Bhy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subset each file and save","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"upG68RF2La"}],"identifier":"subset-each-file-and-save","label":"Subset each file and save","html_id":"subset-each-file-and-save","implicit":true,"key":"Au9zhbVSAn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For each version: load the full table, keep ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FTmvp9gF7l"},{"type":"inlineCode","value":"KEEP_COLS","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nLQdX9dufP"},{"type":"text","value":" (preserving the\ntimestamp index), warn about any requested columns that are absent, and save the\nsubset under the same version-code filename.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UkjXxB7yFa"}],"key":"gewJxzNWhc"}],"key":"dHz1aBDr5G"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-22T14:58:35.803725400Z","start_time":"2026-06-22T14:58:34.665170600Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"saved = {}\nfor f in parquet_files:\n    code = f.stem  # version code, e.g. 'LGR-1'\n    print(f\"\\n=== {code} ===\")\n\n    df = load_parquet(filepath=str(f))\n\n    # Keep only the analysis year.\n    df = df.loc[df.index.year == YEAR]\n\n    present = [c for c in KEEP_COLS if c in df.columns]\n    missing = [c for c in KEEP_COLS if c not in df.columns]\n    if missing:\n        print(f\"  WARNING: {len(missing)} requested column(s) not found: {missing}\")\n\n    subset = df[present]\n    print(f\"  kept {subset.shape[1]} / {len(KEEP_COLS)} columns, \"\n          f\"{subset.shape[0]} rows in {YEAR}\")\n\n    filepath = save_parquet(filename=code, data=subset, outpath=str(OUTDIR))\n    saved[code] = filepath","key":"UeOkr8HIhC"},{"type":"outputs","id":"YWa2EOcRzS5AzK4cCmpUL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n=== LGR-1 ===\n"},"children":[],"key":"YWlE878s1D"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"  \u001b[36m>\u001b[0m Loaded .parquet file 