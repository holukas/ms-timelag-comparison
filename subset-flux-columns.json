text","value":"Select columns","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P7rniwS7nQ"}],"identifier":"select-columns","label":"Select columns","html_id":"select-columns","implicit":true,"key":"pdsKYfgTzL"}],"key":"Nbj777t349"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-24T13:17:07.615632400Z","start_time":"2026-06-24T13:17:07.554851700Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Columns to keep in each subset. Edit this list as the analysis requires.\nKEEP_COLS = [\n    # Fluxes\n    \"FN2O\",\n    \"FCH4\",\n    # N2O time-lag diagnostics\n    \"N2O_TLAG_USED\",\n    # CH4 time-lag diagnostics\n    \"CH4_TLAG_USED\",\n    # Potential shortwave radiation, for splitting fluxes into daytime\n    # (SW_IN_POT > 0) and nighttime (SW_IN_POT == 0) later on.\n    \"SW_IN_POT\",\n]\nprint(f\"{len(KEEP_COLS)} columns requested.\")","key":"RbuGEnz84F"},{"type":"outputs","id":"yn_OsXGClZ1LKQ41wsEmf","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"5 columns requested.\n"},"children":[],"key":"tBZUMcok0Y"}],"key":"ssOI9lhDBs"}],"key":"UOnUHvMFN2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Configuration","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BqzeZiV38q"}],"identifier":"configuration","label":"Configuration","html_id":"configuration","implicit":true,"key":"Mf8nU7CZLi"}],"key":"uaRPWQcxCE"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-24T13:17:07.670556500Z","start_time":"2026-06-24T13:17:07.619656200Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Input / output folders (relative to the notebooks/ directory).\nINDIR = Path(\"../data/01-eddypro_fluxes_level-1_parquet\")\nOUTDIR = Path(\"../data/02-eddypro_fluxes_level-1_parquet_subsets\")\nOUTDIR.mkdir(parents=True, exist_ok=True)\n\n# This analysis uses only one year; rows outside it are dropped from the subsets.\nYEAR = 2021\n\n# Discover the input Parquet files.\nparquet_files = sorted(INDIR.glob(\"*.parquet\"))\nprint(f\"Found {len(parquet_files)} Parquet file(s):\")\nfor f in parquet_files:\n    print(f\"  {f.name}\")","key":"S7hRVJuJ8x"},{"type":"outputs","id":"fOSx_tWS3f01XXpDdnBL2","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Found 10 Parquet file(s):\n  LGR-1.parquet\n  LGR-2.parquet\n  LGR-3.parquet\n  LGR-4.parquet\n  LGR-5.parquet\n  QCL-1.parquet\n  QCL-2.parquet\n  QCL-3.parquet\n  QCL-4.parquet\n  QCL-5.parquet\n"},"children":[],"key":"pEllhPQKDw"}],"key":"Xik7HvKZhR"}],"key":"mJICxeQDUQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Subset each file and save","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JCaVNByEOu"}],"identifier":"subset-each-file-and-save","label":"Subset each file and save","html_id":"subset-each-file-and-save","implicit":true,"key":"E9eASJ8kSq"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For each version: load the full table, keep ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gVHdzf7Erf"},{"type":"inlineCode","value":"KEEP_COLS","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XjDwDHkF9q"},{"type":"text","value":" (preserving the\ntimestamp index), warn about any requested columns that are absent, and save the\nsubset under the same version-code filename.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZdMX8zEC7Q"}],"key":"p07TnuKJww"}],"key":"N6frk9T4T5"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-06-24T13:17:09.293238200Z","start_time":"2026-06-24T13:17:07.673577100Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"saved = {}\nfor f in parquet_files:\n    code = f.stem  # version code, e.g. 'LGR-1'\n    print(f\"\\n=== {code} ===\")\n\n    df = load_parquet(filepath=str(f))\n\n    # Keep only the analysis year.\n    df = df.loc[df.index.year == YEAR]\n\n    present = [c for c in KEEP_COLS if c in df.columns]\n    missing = [c for c in KEEP_COLS if c not in df.columns]\n    if missing:\n        print(f\"  WARNING: {len(missing)} requested column(s) not found: {missing}\")\n\n    subset = df[present]\n    print(f\"  kept {subset.shape[1]} / {len(KEEP_COLS)} columns, \"\n          f\"{subset.shape[0]} rows in {YEAR}\")\n\n    filepath = save_parquet(filename=code, data=subset, outpath=str(OUTDIR))\n    saved[code] = filepath","key":"nngveFXOut"},{"type":"outputs","id":"FGJdBo_N-YoIFhHRNcy0f","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\n=== LGR-1 ===\n"},"children":[],"key":"YtQsYr8VzG"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"  \u001b[36m>\u001b[0m Loaded .parquet file ..\\data\\01-eddypro_fluxes_level-1_parquet\\LGR-1.parquet (0.086 seconds).\n","content_type":"text/plain"},"text/html":{"content":"<pre style=\"white-space:pre;overflow-x:auto;line-height:normal;font-family:Menlo,'DejaVu Sans Mono',consolas,'Courier New',monospace\">  <span style=\"color: #008080; text-decoration-color: #008080\">&gt;</span> Loaded .parquet file ..\\data\\01-eddypro_fluxes_level-1_parquet\\LGR-1.parquet (0.086 seconds).\n</pre>\n","content_type":"text/html"}}},"children":[],"key":"kNw3pAlkEJ"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"  kept 5 / 5 columns, 7803 rows in 2021\n"},"children":[],"key":"PXM4dSjlyp"},{"type":"output","jupyter