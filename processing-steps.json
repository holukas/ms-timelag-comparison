ns.md","dataUrl":"/processing-versions.json","internal":true,"protocol":"file","key":"m4QJjUj2dD"},{"type":"text","value":", and the diive workflow that\napplies it.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ijU84AG5TP"}],"key":"bu7eKrCdPR"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The PWB time-lag method","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"CxWVciBbSp"}],"identifier":"the-pwb-time-lag-method","label":"The PWB time-lag method","html_id":"the-pwb-time-lag-method","implicit":true,"key":"Z9Wtu1m3yQ"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"For reactive and trace gases such as N₂O and CH₄, the gas-wind cross-correlation\nis often too weak for conventional covariance-maximization (CM) to pinpoint the\ntime lag reliably. The ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"V6cyX3piAb"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"JvHXm6ub12"},{"type":"text","value":" versions instead use the Pre-Whitening with\nBlock-bootstrap (PWB) method (Vitale et al., 2024), as implemented in ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"oYfQjJA4UB"},{"type":"inlineCode","value":"diive","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"wZwwfWGwYz"},{"type":"text","value":". It\nworks in two stages.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Spcrv3ukta"}],"key":"FtDLysn7nm"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Pre-whitening.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"v8pUxGIDV3"}],"key":"eOjmyv9QFk"},{"type":"text","value":" An AR(","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"z5jAgcXKZV"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"p","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"wFWG9mDU1t"}],"key":"GbAcie8azu"},{"type":"text","value":") filter (order chosen by AIC) removes serial\nautocorrelation from each series before the cross-correlation function (CCF) is\ncomputed. Turbulent wind and trace-gas series are strongly autocorrelated, which\nbroadens and distorts the CCF peak. Whitening the residuals sharpens the peak and\ngives a cleaner lag estimate.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"uA3OdGrF3J"}],"key":"eP3hGWq1DZ"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Block-bootstrap.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"iHzpPisDfw"}],"key":"bD3vpCCS8D"},{"type":"text","value":" Instead of a single CCF over the whole averaging period, the\nmethod draws ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"dlegsbfk0e"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"N","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"F3nuj2aIbI"}],"key":"wyhGKBGfu3"},{"type":"text","value":"ᵦ resampled series by moving-block resampling, where overlapping\nblocks of length ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"NpBl2VIbln"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"L","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"rzbTJkg2nV"}],"key":"awDwuuGiTw"},{"type":"text","value":" preserve local autocorrelation. It detects the peak lag in\neach resample and summarizes the resulting distribution by its mode (the lag\nestimate) and a 95% Highest Density Interval (HDI). A narrow HDI means resampling\nconsistently finds the same lag, which is the method’s reliability criterion.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"T0K2VphHVt"}],"key":"FjUjYIEasl"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Sonic temperature (T_sonic) is required. Four CCF combinations are evaluated\n(scalar × W and scalar × T_sonic, each with a scalar, W, or T_sonic AR filter),\nand the combination with the strongest peak is selected. The T_sonic-based\ncombinations often recover a cleaner lag for gases with a weak scalar × W signal.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"xQr8pikIkr"}],"key":"AdUcxCFEbK"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Reference: Vitale D. et al. (2024), ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"TiQVZAnBod"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Environmental and Ecological Statistics","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"OCC51YvR2R"}],"key":"EXlydKbWKe"},{"type":"text","value":" 31,\n219-244, ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Z1Lt6LXInp"},{"type":"cite","url":"https://doi.org/10.1007/s10651-024-00615-9","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Vitale ","key":"ZBLRYvbZ0L"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"cSp1sXw4Mv"}],"key":"tFyzC2TO2a"},{"type":"text","value":" (2024)","key":"EztwL4DgK3"}],"kind":"narrative","label":"vitale2024","identifier":"https://doi.org/10.1007/s10651-024-00615-9","enumerator":"1","key":"pimQsBRHbp"},{"type":"text","value":".","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"BBDB9cuC8O"}],"key":"UJtVSSCAGs"},{"type":"heading","depth":2,"position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"text","value":"Workflow","position":{"start":{"line":36,"column":1},"end":{"line":36,"column":1}},"key":"FXHIxFiQSo"}],"identifier":"workflow","label":"Workflow","html_id":"workflow","implicit":true,"key":"vH72U6M5bH"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"p6Jk6KeZit"},{"type":"inlineCode","value":"*-5_PWB","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"lNoUgsNQ8N"},{"type":"text","value":" versions are produced with diive’s detect-and-remove TUI, an\nend-to-end pipeline that detects and removes the lag in a single run. There is no\nlonger a separate pre-rotation step or a separate apply step: rotation is done in\nmemory, and the lag-corrected 30-minute files come straight out. Launch it with:","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"T5ShXTnjiy"}],"key":"RqeLMQCl27"},{"type":"code","lang":"powershell","value":"uv run diive-tlag-pwb-detect-remove-tui","position":{"start":{"line":43,"column":1},"end":{"line":45,"column":1}},"key":"BB30CG6cmW"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"The form sets the input and output paths, the wind (u, v, w) and sonic-temperature\ncolumns, the scalars (CH₄, N₂O), the PWB and chunking parameters, the raw-file\nformat (skip-rows, header rows, separator, file glob), and the per-chunk output\nnaming. Settings persist between sessions in ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"HnRbxM9aqF"},{"type":"inlineCode","value":"~/.diive/detect_remove_tui.yaml","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"knuKBVel69"},{"type":"text","value":", so\nyou enter them only once. The same pipeline runs headless as\n","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"lfX9l9xFBu"},{"type":"inlineCode","value":"uv run diive-tlag-pwb-detect-remove","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"KYmo2Q2HMy"},{"type":"text","value":".","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"v0ILPR35gS"}],"key":"yZIgUG2OrJ"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Each long raw file (e.g. 6 h) is read once and processed in 30-minute chunks\nsnapped to the wall-clock grid (:00 / :30), in two phases:","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"qQy1Skv3i8"}],"key":"F05ikSeVqe"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":57,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Detect.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"L4jqdWuUZP"}],"key":"H8h59qSiuS"},{"type":"text","value":" For each chunk, the wind vector is double-rotated in memory (the\nrotated data are never written to disk), and ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"ylPKRV2AFz"},{"type":"inlineCode","value":"PreWhiteningBootstrap","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"FPyKIhgUhi"},{"type":"text","value":" runs on\nthe rotated W, each scalar, and sonic temperature to estimate the lag per gas.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"o1bg4FbkvR"}],"key":"SmnHeKSAJz"}],"key":"ILYvsrQEVg"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"PWBOPT.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"OJo4FwN7xo"}],"key":"CVev9Wr6AV"},{"type":"text","value":" Once every chunk is detected, the PWBOPT decision rule (S1/S2/S3\ncarry-forward and gap-fill) is applied across the ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"ZcPPZNpAbI"},{"type":"emphasis","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"whole","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"mzyyN2VTx1"}],"key":"mvEmbtkLSh"},{"type":"text","value":" chunk sequence in\ntemporal order to pick the best lag for each chunk. This replaces a spurious\nwide-HDI estimate with the neighboring optimal lag.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"SWSpGSKX6W"}],"key":"yP7LQ2z70Q"}],"key":"VVjVvpAhrw"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Remove.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Pd8WVDkAhu"}],"key":"rGZJmVTyZt"},{"type":"text","value":" Each scalar in the unrotated chunk is shifted back by the\noptimized lag, and the lag-corrected chunk is written as its own 30-minute\nfile, with the original header rows and column order preserved.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Qp2WFof6tH"}],"key":"HT4E8NWxk6"}],"key":"qf9obk874L"}],"key":"autXcX8edT"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Outputs land in the output directory: the lag-corrected 30-minute files, a\nsummary table (","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"OVROlqbkiN"},{"type":"inlineCode","value":"1_lag_detection/detect_and_remove_tlag_summary.csv","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"IfkCcGdqmC"},{"type":"text","value":"), optional\noverview plots, and a ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"e2t0I4VeG9"},{"type":"inlineCode","value":"log.txt","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"bRcECwk8gg"},{"type":"text","value":" of the run.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"xPI1kQm3Dp"}],"key":"aydN0XK5yc"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"The lag-corrected files then go through normal flux processing with EC time-lag\nmaximization disabled, because the tube delay has already been corrected here.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"IhG4Qmd8uw"}],"key":"wMCC8ELgNe"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"strong","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Keep H₂O in the EddyPro settings.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"Mc9ziyqbTK"}],"key":"Gc98BCJcdM"},{"type":"text","value":" Even though the study only looks at the\nN₂O and CH₄ fluxes, water vapor must still be included in the run. The\nhigh-frequency spectral correction (here EddyPro’s Fratini method) is humidity\ndependent and uses the H₂O series to characterize the tube attenuation, so\ndropping H₂O changes the correction applied to N₂O and CH₄ and biases their\nfluxes low. This matters for a fair comparison: the ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"P3HZWsvFWg"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"lKUTBVHqeJ"},{"type":"text","value":" runs should differ\nfrom the other versions only in how the N₂O and CH₄ lag is handled, not in\nwhether H₂O is present. Only the N₂O and CH₄ lag is removed beforehand (that is\nthe study variable); the H₂O lag is left in the raw data and compensated by\nEddyPro in the normal way, using the same constant H₂O lag as the other\nversions.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"iPOnvAPDBX"}],"key":"wnsee9aPVZ"}],"key":"SfChDEIyZC"}],"key":"U7cJZCvUc7"},"references":{"cite":{"order":["vitale2024"],"data":{"vitale2024":{"label":"vitale2024","enumerator":"1","doi":"10.1007/s10651-024-00615-9","html":"Vitale, D., Fratini, G., Helfter, C., Hörtnagl, L., Kohonen, K.-M., Mammarella, I., Nemitz, E., Nicolini, G., Rebmann, C., Sabbatini, S., & Papale, D. (2024). A pre-whitening with block-bootstrap cross-correlation procedure for temporal alignment of data sampled by eddy covariance systems. <i>Environmental and Ecological Statistics</i>, <i>31</i>, 219–244. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1007/s10651-024-00615-9\">10.1007/s10651-024-00615-9</a>","url":"https://doi.org/10.1007/s10651-024-00615-9"}}}},"footer":{"navigation":{"prev":{"title":"Processing versions","url":"/processing-versions","group":"Impact of time-lag settings on N₂O and CH₄ eddy covariance fluxes"},"next":{"title":"Data","url":"/data","group":"Impact of time-lag settings on N₂O and CH₄ eddy covariance fluxes"}}},"domain":"http://localhost:3000"}