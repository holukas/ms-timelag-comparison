 (u, v, w) and sonic-temperature\ncolumns, the scalars (CH₄, N₂O), the PWB and chunking parameters, the raw-file\nformat (skip-rows, header rows, separator, file glob), and the per-chunk output\nnaming. Settings persist between sessions in ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"HMnSN8axvU"},{"type":"inlineCode","value":"~/.diive/detect_remove_tui.yaml","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"dgkDUfgeYh"},{"type":"text","value":", so\nyou enter them only once. The same pipeline runs headless as\n","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ig3YXAP2XN"},{"type":"inlineCode","value":"uv run diive-tlag-pwb-detect-remove","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"W07DPXfWCl"},{"type":"text","value":".","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ChTVGDqUm2"}],"key":"YIBh50fmdr"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Each long raw file (e.g. 6 h) is read once and processed in 30-minute chunks\nsnapped to the wall-clock grid (:00 / :30), in two phases:","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"Ptu385xypZ"}],"key":"Na3DhYI03R"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":57,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Detect.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"vwM581dgzQ"}],"key":"uQOLtjRVFa"},{"type":"text","value":" For each chunk, the wind vector is double-rotated in memory (the\nrotated data are never written to disk), and ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"eDKgKsMhCA"},{"type":"inlineCode","value":"PreWhiteningBootstrap","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"xgMojZLWvj"},{"type":"text","value":" runs on\nthe rotated W, each scalar, and sonic temperature to estimate the lag per gas.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"FjrFa8hHSV"}],"key":"AankejW17b"}],"key":"M9xWtJU6Tf"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"PWBOPT.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"uBP6ku6bwm"}],"key":"NIDJCVINJX"},{"type":"text","value":" Once every chunk is detected, the PWBOPT decision rule (S1/S2/S3\ncarry-forward and gap-fill) is applied across the ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"oJry2BQWgN"},{"type":"emphasis","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"whole","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"MIYAENd2FY"}],"key":"rKDeIM2XNP"},{"type":"text","value":" chunk sequence in\ntemporal order to pick the best lag for each chunk. This replaces a spurious\nwide-HDI estimate with the neighboring optimal lag.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"ND6zyNSyDM"}],"key":"LpexOhkFlW"}],"key":"XmCGN305p7"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Remove.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"D3X2LYI66z"}],"key":"OicEGYAN9T"},{"type":"text","value":" Each scalar in the unrotated chunk is shifted back by the\noptimized lag, and the lag-corrected chunk is written as its own 30-minute\nfile, with the original header rows and column order preserved.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"fwkbYTjsrX"}],"key":"vzQM2t2HS7"}],"key":"BXh51RNIte"}],"key":"GaCuRaB4Et"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Outputs land in the output directory: the lag-corrected 30-minute files, a\nsummary table (","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"UjaJMLJv6u"},{"type":"inlineCode","value":"1_lag_detection/detect_and_remove_tlag_summary.csv","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"mhjfpMYQDp"},{"type":"text","value":"), optional\noverview plots, and a ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"pToJqLKaeU"},{"type":"inlineCode","value":"log.txt","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"g1fcqAz9Ej"},{"type":"text","value":" of the run.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"BuUBkVtNnc"}],"key":"zqEVCgqdhS"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"The lag-corrected files then go through normal flux processing with EC time-lag\nmaximization disabled, because the tube delay has already been corrected here.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"BzoW3xA0y3"}],"key":"VAfJQVGQRm"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"strong","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Keep H₂O in the EddyPro settings.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"mwovUQ0hAJ"}],"key":"HicwbbIYdp"},{"type":"text","value":" Even though the study only looks at the\nN₂O and CH₄ fluxes, water vapor must still be included in the run. The\nhigh-frequency spectral correction (here EddyPro’s Fratini method) is humidity\ndependent and uses the H₂O series to characterize the tube attenuation, so\ndropping H₂O changes the correction applied to N₂O and CH₄ and biases their\nfluxes low. This matters for a fair comparison: the ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"eesa2R4nL5"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"aWYWxNa3IG"},{"type":"text","value":" runs should differ\nfrom the other versions only in how the N₂O and CH₄ lag is handled, not in\nwhether H₂O is present. Only the N₂O and CH₄ lag is removed beforehand (that is\nthe study variable); the H₂O lag is left in the raw data and compensated by\nEddyPro in the normal way, using the same constant H₂O lag as the other\nversions.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"ASsdDC5kwg"}],"key":"UbFFnB5Zv7"}],"key":"dGidBkDJ0h"}],"key":"NQNOi5Dfgn"},"references":{"cite":{"order":["vitale2024"],"data":{"vitale2024":{"label":"vitale2024","enumerator":"1","doi":"10.1007/s10651-024-00615-9","html":"Vitale, D., Fratini, G., Helfter, C., Hörtnagl, L., Kohonen, K.-M., Mammarella, I., Nemitz, E., Nicolini, G., Rebmann, C., Sabbatini, S., & Papale, D. (2024). A pre-whitening with block-bootstrap cross-correlation procedure for temporal alignment of data sampled by eddy covariance systems. <i>Environmental and Ecological Statistics</i>, <i>31</i>, 219–244. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1007/s10651-024-00615-9\">10.1007/s10651-024-00615-