ns.md","dataUrl":"/processing-versions.json","internal":true,"protocol":"file","key":"LsSP2eXQvh"},{"type":"text","value":", and the diive workflow that\napplies it.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DxVjDqbfHT"}],"key":"roAz3nMUHS"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The PWB time-lag method","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ybJdYoy0jR"}],"identifier":"the-pwb-time-lag-method","label":"The PWB time-lag method","html_id":"the-pwb-time-lag-method","implicit":true,"key":"fHlLhZpO2q"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"For reactive and trace gases such as N₂O and CH₄, the gas-wind cross-correlation\nis often too weak for conventional covariance-maximization (CM) to pinpoint the\ntime lag reliably. The ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"VIJK4RWC96"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"spuw48dDEN"},{"type":"text","value":" versions instead use the Pre-Whitening with\nBlock-bootstrap (PWB) method (Vitale et al., 2024), as implemented in ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"XKSYf5XguO"},{"type":"inlineCode","value":"diive","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"lZuFM44FbZ"},{"type":"text","value":". It\nworks in two stages.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"ndeHdYMJBi"}],"key":"SZaHQ7mWSU"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Pre-whitening.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"O4TDwDmUps"}],"key":"fgRXRsgSgU"},{"type":"text","value":" An AR(","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"IACnwUCoZC"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"p","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"HlSLRKp1ka"}],"key":"hzZDiC5tK6"},{"type":"text","value":") filter (order chosen by AIC) removes serial\nautocorrelation from each series before the cross-correlation function (CCF) is\ncomputed. Turbulent wind and trace-gas series are strongly autocorrelated, which\nbroadens and distorts the CCF peak. Whitening the residuals sharpens the peak and\ngives a cleaner lag estimate.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"F2S4Jedmvt"}],"key":"jF7dmp66LN"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Block-bootstrap.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"xrbvCZhPLr"}],"key":"RnC9NwEOUg"},{"type":"text","value":" Instead of a single CCF over the whole averaging period, the\nmethod draws ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"jWDBN8Mw6P"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"N","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"PiZRQaZAP8"}],"key":"KDgAarmLRL"},{"type":"text","value":"ᵦ resampled series by moving-block resampling, where overlapping\nblocks of length ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"adblicRNGW"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"L","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"BIV937jAKu"}],"key":"xEMDdpf52T"},{"type":"text","value":" preserve local autocorrelation. It detects the peak lag in\neach resample and summarizes the resulting distribution by its mode (the lag\nestimate) and a 95% Highest Density Interval (HDI). A narrow HDI means resampling\nconsistently finds the same lag, which is the method’s reliability criterion.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"I20LOp8gfz"}],"key":"qnPit8eRPE"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Sonic temperature (T_sonic) is required. Four CCF combinations are evaluated\n(scalar × W and scalar × T_sonic, each with a scalar, W, or T_sonic AR filter),\nand the combination with the strongest peak is selected. The T_sonic-based\ncombinations often recover a cleaner lag for gases with a weak scalar × W signal.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"LxKORPircs"}],"key":"GyJhKtKzkO"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Reference: Vitale D. et al. (2024), ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ogzgixe88m"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Environmental and Ecological Statistics","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"p25oR25uqC"}],"key":"Vb6Ze7r2g0"},{"type":"text","value":" 31,\n219-244, ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"MDcZ9AS2UX"},{"type":"cite","url":"https://doi.org/10.1007/s10651-024-00615-9","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"child