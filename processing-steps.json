ns.md","dataUrl":"/processing-versions.json","internal":true,"protocol":"file","key":"L9dBfyyJY8"},{"type":"text","value":", and the diive workflow that\napplies it.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HW2GXu74zo"}],"key":"GPCiRGUVgs"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The PWB time-lag method","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"fHXNh532Fg"}],"identifier":"the-pwb-time-lag-method","label":"The PWB time-lag method","html_id":"the-pwb-time-lag-method","implicit":true,"key":"pln3gEnkPT"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"For reactive and trace gases such as N₂O and CH₄, the gas-wind cross-correlation\nis often too weak for conventional covariance-maximization (CM) to pinpoint the\ntime lag reliably. The ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"XZlJKpe7CM"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"gaCLy3y14S"},{"type":"text","value":" versions instead use the Pre-Whitening with\nBlock-bootstrap (PWB) method (Vitale et al., 2024), as implemented in ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"yUePNQTShP"},{"type":"inlineCode","value":"diive","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"QNPyJ0Inzs"},{"type":"text","value":". It\nworks in two stages.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"JUmgTTqlCd"}],"key":"zGR9LUvZsd"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Pre-whitening.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"ascF3tH0kV"}],"key":"XqxART4toZ"},{"type":"text","value":" An AR(","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"ORSaBqpoDL"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"p","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"coefutFcWj"}],"key":"NnjARMT78D"},{"type":"text","value":") filter (order chosen by AIC) removes serial\nautocorrelation from each series before the cross-correlation function (CCF) is\ncomputed. Turbulent wind and trace-gas series are strongly autocorrelated, which\nbroadens and distorts the CCF peak. Whitening the residuals sharpens the peak and\ngives a cleaner lag estimate.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"xBpO0VrQiB"}],"key":"kCdcqk2xiy"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Block-bootstrap.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"XWdKXlhuvv"}],"key":"pT8rfrzg2y"},{"type":"text","value":" Instead of a single CCF over the whole averaging period, the\nmethod draws ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"datJDzEXlw"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"N","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"mrqJJ3egaV"}],"key":"xqJd3ezvL5"},{"type":"text","value":"ᵦ resampled series by moving-block resampling, where overlapping\nblocks of length ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"upE3jqdRIt"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"L","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"EL8v1kGOdB"}],"key":"VDlKnEnEQo"},{"type":"text","value":" preserve local autocorrelation. It detects the peak lag in\neach resample and summarizes the resulting distribution by its mode (the lag\nestimate) and a 95% Highest Density Interval (HDI). A narrow HDI means resampling\nconsistently finds the same lag, which is the method’s reliability criterion.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"ozpgIVuqga"}],"key":"MYfzWYtUuj"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Sonic temperature (T_sonic) is required. Four CCF combinations are evaluated\n(scalar × W and scalar × T_sonic, each with a scalar, W, or T_sonic AR filter),\nand the combination with the strongest peak is selected. The T_sonic-based\ncombinations often recover a cleaner lag for gases with a weak scalar × W signal.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"KKEzUMVlTn"}],"key":"XyG94puasF"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Reference: Vitale D. et al. (2024), ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"P374bQRHqY"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Environmental and Ecological Statistics","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"ONtD7cvfe7"}],"key":"C3wNfdHv74"},{"type":"text","value":" 31,\n219-244, ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"hQargXrDKL"},{"type":"cite","url":"https://doi.org/10.1007/s10651-024-00615-9","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"child