 (u, v, w) and sonic-temperature\ncolumns, the scalars (CH₄, N₂O), the PWB and chunking parameters, the raw-file\nformat (skip-rows, header rows, separator, file glob), and the per-chunk output\nnaming. Settings persist between sessions in ","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"wrrCRw9yt1"},{"type":"inlineCode","value":"~/.diive/detect_remove_tui.yaml","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Bksh24yaow"},{"type":"text","value":", so\nyou enter them only once. The same pipeline runs headless as\n","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"DZZMvJndDd"},{"type":"inlineCode","value":"uv run diive-tlag-pwb-detect-remove","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"DQlfjJHArd"},{"type":"text","value":".","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"rsnWPpF1cS"}],"key":"MW241g2Dt3"},{"type":"paragraph","position":{"start":{"line":54,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Each long raw file (e.g. 6 h) is read once and processed in 30-minute chunks\nsnapped to the wall-clock grid (:00 / :30), in two phases:","position":{"start":{"line":54,"column":1},"end":{"line":54,"column":1}},"key":"JwzwMIx4BU"}],"key":"FZ1xFoMHQb"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":57,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":57,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Detect.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"EujNfH0lEf"}],"key":"WaC1AjCpNT"},{"type":"text","value":" For each chunk, the wind vector is double-rotated in memory (the\nrotated data are never written to disk), and ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"oAXZzIgGSN"},{"type":"inlineCode","value":"PreWhiteningBootstrap","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"iJtfFICyRu"},{"type":"text","value":" runs on\nthe rotated W, each scalar, and sonic temperature to estimate the lag per gas.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"ftHRdZdRZh"}],"key":"yXTOieMsEI"}],"key":"bICH8AyMbi"},{"type":"listItem","spread":true,"position":{"start":{"line":60,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"PWBOPT.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"ip4dOGmfuC"}],"key":"pbSPadHom3"},{"type":"text","value":" Once every chunk is detected, the PWBOPT decision rule (S1/S2/S3\ncarry-forward and gap-fill) is applied across the ","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"g3DoPRBceV"},{"type":"emphasis","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"children":[{"type":"text","value":"whole","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"D89Zxc9OUm"}],"key":"mw3iUvIXWu"},{"type":"text","value":" chunk sequence in\ntemporal order to pick the best lag for each chunk. This replaces a spurious\nwide-HDI estimate with the neighboring optimal lag.","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"qAmeHQT6kJ"}],"key":"j3J1T2ol3a"}],"key":"yjkAFDcEWR"},{"type":"listItem","spread":true,"position":{"start":{"line":64,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Remove.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"Z5xsB3DwfL"}],"key":"SChgnj6Yzs"},{"type":"text","value":" Each scalar in the unrotated chunk is shifted back by the\noptimized lag, and the lag-corrected chunk is written as its own 30-minute\nfile, with the original header rows and column order preserved.","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"lx6U0xixy5"}],"key":"nDEvmhm3rG"}],"key":"Zvshr0yyz2"}],"key":"D4fJ1c7WMY"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"Outputs land in the output directory: the lag-corrected 30-minute files, a\nsummary table (","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"g9bf2neogD"},{"type":"inlineCode","value":"1_lag_detection/detect_and_remove_tlag_summary.csv","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"qfHwGwaJAI"},{"type":"text","value":"), optional\noverview plots, and a ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"uxwUhA15yi"},{"type":"inlineCode","value":"log.txt","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"CKFR9nc7Sf"},{"type":"text","value":" of the run.","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"oFWI7oV83d"}],"key":"ucP9zn0EEA"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"The lag-corrected files then go through normal flux processing with EC time-lag\nmaximization disabled, because the tube delay has already been corrected here.","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"TRN4Ahux06"}],"key":"eCwAWl7wXn"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"strong","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"Keep H₂O in the EddyPro settings.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"k3ni1r3NIM"}],"key":"X1pAR8FO0P"},{"type":"text","value":" Even though the study only looks at the\nN₂O and CH₄ fluxes, water vapor must still be included in the run. The\nhigh-frequency spectral correction (here EddyPro’s Fratini method) is humidity\ndependent and uses the H₂O series to characterize the tube attenuation, so\ndropping H₂O changes the correction applied to N₂O and CH₄ and biases their\nfluxes low. This matters for a fair comparison: the ","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"DDsaAE8cYh"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"Vu1Kx0oI3B"},{"type":"text","value":" runs should differ\nfrom the other versions only in how the N₂O and CH₄ lag is handled, not in\nwhether H₂O is present. Only the N₂O and CH₄ lag is removed beforehand (that is\nthe study variable); the H₂O lag is left in the raw data and compensated by\nEddyPro in the normal way, using the same constant H₂O lag as the other\nversions.","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"OwMxDkaOgZ"}],"key":"SCsjQFULZK"}],"key":"R5htdCNwkT"}],"key":"OBo2F5qcXZ"},"references":{"cite":{"order":["vitale2024"],"data":{"vitale2024":{"label":"vitale2024","enumerator":"1","doi":"10.1007/s10651-024-00615-9","html":"Vitale, D., Fratini, G., Helfter, C., Hörtnagl, L., Kohonen, K.-M., Mammarella, I., Nemitz, E., Nicolini, G., Rebmann, C., Sabbatini, S., & Papale, D. (2024). A pre-whitening with block-bootstrap cross-correlation procedure for temporal alignment of data sampled by eddy covariance systems. <i>Environmental and Ecological Statistics</i>, <i>31</i>, 219–244. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1007/s10651-024-00615-9\">10.1007/s10651-024-00615-