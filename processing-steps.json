ns.md","dataUrl":"/processing-versions.json","internal":true,"protocol":"file","key":"SkMVdwZNKj"},{"type":"text","value":", and the diive workflow that\napplies it.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BgSqerFzAZ"}],"key":"KfgNhRKLkd"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"The PWB time-lag method","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"eJqGYXxrMF"}],"identifier":"the-pwb-time-lag-method","label":"The PWB time-lag method","html_id":"the-pwb-time-lag-method","implicit":true,"key":"LA62q9lvdq"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"For reactive and trace gases such as N₂O and CH₄, the gas-wind cross-correlation\nis often too weak for conventional covariance-maximization (CM) to pinpoint the\ntime lag reliably. The ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"OfWOavlFcL"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"oJfMeK6Yq2"},{"type":"text","value":" versions instead use the Pre-Whitening with\nBlock-bootstrap (PWB) method (Vitale et al., 2024), as implemented in ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"jYV56wdWRZ"},{"type":"inlineCode","value":"diive","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"AwImwkRtMW"},{"type":"text","value":". It\nworks in two stages.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"DFe076j5DJ"}],"key":"Ez09S224dt"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Pre-whitening.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"zMAAaBfc33"}],"key":"FQ4L7sNCmI"},{"type":"text","value":" An AR(","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"HMtrzdK2Tz"},{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"p","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"auIAHfu4lb"}],"key":"aXvUSPVnMn"},{"type":"text","value":") filter (order chosen by AIC) removes serial\nautocorrelation from each series before the cross-correlation function (CCF) is\ncomputed. Turbulent wind and trace-gas series are strongly autocorrelated, which\nbroadens and distorts the CCF peak. Whitening the residuals sharpens the peak and\ngives a cleaner lag estimate.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"rmm02EY3Qa"}],"key":"qc4skAhHzJ"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"strong","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Block-bootstrap.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"BO2Q8DLpsV"}],"key":"RPgnaFd1fT"},{"type":"text","value":" Instead of a single CCF over the whole averaging period, the\nmethod draws ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"vHBWNy9xKB"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"N","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"jcl9wS6iWt"}],"key":"Ot39mm9M5d"},{"type":"text","value":"ᵦ resampled series by moving-block resampling, where overlapping\nblocks of length ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"GP3eaVA4ct"},{"type":"emphasis","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"L","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"D0c5BHolao"}],"key":"z9AbNkm2yt"},{"type":"text","value":" preserve local autocorrelation. It detects the peak lag in\neach resample and summarizes the resulting distribution by its mode (the lag\nestimate) and a 95% Highest Density Interval (HDI). A narrow HDI means resampling\nconsistently finds the same lag, which is the method’s reliability criterion.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"WJulnmA0Kq"}],"key":"INrhoyMRdY"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Sonic temperature (T_sonic) is required. Four CCF combinations are evaluated\n(scalar × W and scalar × T_sonic, each with a scalar, W, or T_sonic AR filter),\nand the combination with the strongest peak is selected. The T_sonic-based\ncombinations often recover a cleaner lag for gases with a weak scalar × W signal.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"c4rKj7rfop"}],"key":"gvWC2zfGvg"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"text","value":"Reference: Vitale D. et al. (2024), ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"hTZK7NOOtJ"},{"type":"emphasis","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Environmental and Ecological Statistics","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"nmXyTNK0qr"}],"key":"paBHgMwY4R"},{"type":"text","value":" 31,\n219-244, ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"N0foRFuWWe"},{"type":"cite","url":"https://doi.org/10.1007/s10651-024-00615-9","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"child