STAR scenario is shown, ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"HGRQxthfOK"},{"type":"inlineCode","value":"USTAR_SCENARIO","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"RnNpNfLYyr"},{"type":"text","value":"; re-run with a different value to\ncompare scenarios. Two figures are produced, one per gas, saved as\n","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"bOfLPO6Lg8"},{"type":"inlineCode","value":"figures/09_cumulative_{scenario}_{gas}.png","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"DStiq8agg3"},{"type":"text","value":".","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"hECir3LkuL"}],"key":"OxdWOJ5byQ"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Inputs:","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"EkKzg0KP2k"}],"key":"RO2BDDkRYt"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"data/05-flux_processing_chain_parquet/","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"HgUlAnPJGl"},{"type":"text","value":" for the QC fluxes.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"w7eAg45x3b"}],"key":"DCniTvhnqr"}],"key":"ZyafsLhIi8"}],"key":"yW0xsviPaU"}],"key":"iyb6OtYBOF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Imports","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BymvVLvswQ"}],"identifier":"imports","label":"Imports","html_id":"imports","implicit":true,"key":"xwuBZkgS9B"}],"key":"x4QQGnvO15"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-07-01T16:30:51.844893700Z","start_time":"2026-07-01T16:30:51.822448100Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\nfrom pathlib import Path\n\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\nfrom diive.core.io.files import load_parquet\n\n# White figure background (on screen and in saved PNGs).\nplt.rcParams[\"figure.facecolor\"] = \"white\"\nplt.rcParams[\"savefig.facecolor\"] = \"white\"\nplt.rcParams[\"axes.facecolor\"] = \"white\"\n\nNB_START = datetime.now()  # notebook start time (reported in the last cell)","key":"gDDGG1DF0O"},{"type":"outputs","id":"lwI2APVXiCnlCyQKURkxj","children":[],"key":"ljbNMTqIlo"}],"key":"xkmr41SryB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Configuration","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RxHw8Wjxlu"}],"identifier":"configuration","label":"Configuration","html_id":"configuration","implicit":true,"key":"jpm65k6Hrq"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"inlineCode","value":"USTAR_SCENARIO","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mPJsf8XjO6"},{"type":"text","value":" selects which of the three USTAR-filtered fluxes to sum. The QC\nflux column in each ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rw6XMAR65B"},{"type":"inlineCode","value":"*_fpc.parquet","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a3eHbPQRP0"},{"type":"text","value":" follows the chain’s naming convention,\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rA5vfHkKaV"},{"type":"inlineCode","value":"{gas}_L3.1_L3.3_{scenario}_QCF","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yoiGKPqUhJ"},{"type":"text","value":". All five variants per analyzer are summed,\nincluding the PWB variant (","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"j686lSGwL9"},{"type":"inlineCode","value":"*-5","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Q5ISdH6H2N"},{"type":"text","value":").","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ITnsAdKBaI"}],"key":"gVNeov5NMQ"}],"key":"Edx0KPCbUM"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-07-01T16:30:51.900726300Z","start_time":"2026-07-01T16:30:51.862409900Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"FPCDIR = Path(\"../data/05-flux_processing_chain_parquet\")  # QC fluxes\nFIGDIR = Path(\"../figures\")\nFIGDIR.mkdir(parents=True, exist_ok=True)\n\nYEAR = 2021\nUSTAR_SCENARIO = \"CUT_50\"  # one of CUT_16 / CUT_50 / CUT_84\nDPI = 300\n\n# Cumulative-mass conversion. The fluxes are half-hourly in nmol m-2 s-1, so each\n# record integrates over RECORD_SECONDS. The per-record factor turns one\n# nmol m-2 s-1 value into cumulative mass of the reported element:\n#   nmol m-2 s-1  * RECORD_SECONDS  -> nmol m-2   (per 30-min record)\n#                 * 1e-9            -> mol m-2\n#                 * molar mass      -> g (element) m-2\n# N2O is reported as N2O-N (two N atoms per molecule) and taken to kg ha-1;\n# CH4 is reported as CH4-C and kept in g m-2.\nRECORD_SECONDS = 1800     # 30-min flux averaging interval\nM_N = 14.0067             # g mol-1, nitrogen\nM_C = 12.011              # g mol-1, carbon\nG_M2_TO_KG_HA = 10.0      # (g m-2) -> (kg ha-1): / 1000 g * 10000 m2\n\n# The five time-lag variants per analyzer (the study variable).\nANALYZERS = {\n    \"QCL\": [\"QCL-1\", \"QCL-2\", \"QCL-3\", \"QCL-4\", \"QCL-5\"],\n    \"LGR\": [\"LGR-1\", \"LGR-2\", \"LGR-3\", \"LGR-4\", \"LGR-5\"],\n}\n\n# Per gas: flux column, pretty label, the cumulative-mass factor, and the unit of\n# the cumulative series.\nGASES = {\n    \"N2O\": {\"flux\": \"FN2O\", \"label\": \"N$_2$O\",\n            \"factor\": RECORD_SECONDS * 1e-9 * (2 * M_N) * G_M2_TO_KG_HA,\n            \"cum_unit\": \"kg N$_2$O-N ha$^{-1}$\"},\n    \"CH4\": {\"flux\": \"FCH4\", \"label\": \"CH$_4$\",\n            \"factor\": RECORD_SECONDS * 1e-9 * M_C,\n            \"cum_unit\": \"g CH$_4$-C m$^{-2}$\"},\n}\n\n# Meaningful variant names (by suffix number), matching notebook 08. Used as the\n# legend labels instead of the bare codes.\nVARIANT_NAMES = {\n    1: \"Max. covariance, wide, no default\",\n    2: \"Max. covariance, wide, default\",\n    3: \"Max. covariance, narrow, default\",\n    4: \"Constant lag\",\n    5: \"PWB\",\n}\n\n# One color per variant suffix, shared across analyzers and gases.\nVAR_COLORS = {1: \"#1b9e77\", 2: \"#d95f02\", 3: \"#7570b3\", 4: \"#e7298a\", 5: \"#66a61e\"}\n\n\ndef qc_col(fluxvar, scenario):\n    \"\"\"Name of the USTAR-filtered, QCF-accepted flux column in the fpc output.\"\"\"\n    return f\"{fluxvar}_L3.1_L3.3_{scenario}_QCF\"\n\n\ndef variant_num(code):\n    \"\"\"Trailing variant number of a code, e.g. 'QCL-3' -> 3.\"\"\"\n    return int(code.split(\"-\", 1)[1])\n\n\nprint(f\"Cumulative QC flux, USTAR scenario: {USTAR_SCENARIO}\")","key":"I4chVvhz92"},{"type":"outputs","id":"IYZE1LHKjZQ7sK_9q7652","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Cumulative QC flux, USTAR scenario: CUT_50\n"},"children":[],"key":"vo7PhSz6QB"}],"key":"QJJa70Bvd4"}],"key":"wq3syDy99R"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Load the QC fluxes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nllbOmnSfO"}],"identifier":"load-the-qc-fluxes","label":"Load the QC fluxes","html_id":"load-the-qc-fluxes","implicit":true,"key":"Fkhf6YdX5l"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For each variant and gas, the QC flux is pulled from its ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"J7eYChPeIM"},{"type":"inlineCode","value":"*_fpc.parquet","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vQk6ZNbZxj"},{"type":"text","value":" (the\nsingle ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sxua8yFukJ"},{"type":"inlineCode","value":"USTAR_SCENARIO","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TQC1TxlEoj"},{"type":"text","value":" column), restricted to the analysis year.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FcT9I0jesV"}],"key":"SIuPdGGN9T"}],"key":"TUAXmV7tsW"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-07-01T16:30:52.806717300Z","start_time":"2026-07-01T16:30:51.903246900Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"all_codes = [c for codes in ANALYZERS.values() for c in codes]\n\nqcflux = {}  # (code, gas-name) -> QC flux series for the chosen USTAR scenario\nfor code in all_codes:\n    for gas, v in GASES.items():\n        df = load_parquet(filepath=str(FPCDIR / f\"{code}_{v['flux']}_fpc.parquet\"))\n        df = df.loc[df.index.year == YEAR]\n        qcflux[(code, gas)] = df[qc_col(v[\"flux\"], USTAR_SCENARIO)]\n\nfor code in all_codes:\n    n = int(qcflux[(code, \"N2O\")].notna().sum())\n    print(f\"{code}: {n} valid QC N2O ({USTAR_SCENARIO})\")","key":"N6zUU9aOXo"},{"type":"outputs","id":"Evzx3BWhyvOmVU1zthw-G","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{