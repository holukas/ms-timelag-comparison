_50)\nLGR-4: 4362 valid QC N2O (CUT_50)\nLGR-5: 4339 valid QC N2O (CUT_50)\n"},"children":[],"key":"ANO17p7j4u"}],"key":"JI5PctbiJi"}],"key":"qb9w2QP0ju"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cumulative flux over common samples","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"w8ceUKB9VF"}],"identifier":"cumulative-flux-over-common-samples","label":"Cumulative flux over common samples","html_id":"cumulative-flux-over-common-samples","implicit":true,"key":"gt2P8H3aiw"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"One figure per gas, two panels: QCL (left) and LGR (right). Within each analyzer\nthe variants are aligned and reduced to their common samples, then integrated over\ntime into a cumulative mass: N2O as kg N2O-N ha⁻¹ and CH4 as g CH4-C m⁻². Each\nvariant is labelled by its time-lag scheme, and its ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FQB6C3cHKk"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"overall total","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Jv4iWSnNRd"}],"key":"gYcGqy0YNe"},{"type":"text","value":" (the final\ncumulative value over the common samples) is shown in the legend, so the budget\ndifferences between variants are read directly.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"at4d4j49uB"}],"key":"lpb57MnLs2"}],"key":"BY512akA2M"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2026-07-01T16:30:54.849459800Z","start_time":"2026-07-01T16:30:52.837435100Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"def style_axes(ax):\n    \"\"\"Black spines, short outward ticks, no grid.\"\"\"\n    ax.grid(False)\n    for spine in ax.spines.values():\n        spine.set_color(\"black\")\n        spine.set_linewidth(0.8)\n    ax.tick_params(which=\"major\", length=3.5, width=0.8, direction=\"out\", color=\"black\")\n\n\nfor gas, v in GASES.items():\n    factor, cum_unit = v[\"factor\"], v[\"cum_unit\"]\n    fig, axes = plt.subplots(1, len(ANALYZERS), figsize=(14, 5),\n                             constrained_layout=True, squeeze=False)\n    for ci, (analyzer, codes) in enumerate(ANALYZERS.items()):\n        ax = axes[0, ci]\n\n        # Align the variants, keep only the common samples, then integrate the\n        # half-hourly flux into a cumulative mass.\n        frame = pd.DataFrame({code: qcflux[(code, gas)] for code in codes})\n        common = frame.dropna(how=\"any\")\n        cum = common.cumsum() * factor\n\n        for code in codes:\n            num = variant_num(code)\n            total = cum[code].iloc[-1] if len(cum) else float(\"nan\")\n            ax.plot(cum.index, cum[code], lw=1.6, color=VAR_COLORS[num],\n                    label=f\"{VARIANT_NAMES[num]}: {total:.3g}\")\n        if len(cum.index):\n            ax.set_xlim(cum.index.min(), cum.index.max())\n        ax.set_ylim(bottom=0)  # start the y-axis at exactly zero\n        ax.set_title(f\"{analyzer} (n={common.shape[0]})\", fontweight=\"bold\")\n        style_axes(ax)\n        ax.legend(fontsize=8, loc=\"upper left\", title=f\"Variant: total ({cum_unit})\")\n\n    axes[0, 0].set_ylabel(f\"Cumulative flux ({cum_unit})\")\n    out = FIGDIR / f\"09_cumulative_{USTAR_SCENARIO.lower()}_{gas.lower()}.png\"\n    fig.savefig(out, dpi=DPI, bbox_inches=\"tight\")\n    print(f\"Saved {out}\")\n    plt.show()","key":"bfXJrbyPSq"},{"type":"outputs","id":"VdyfWbKq9pQhNkcNAByvL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Saved ..\\figures\\09_cumulative_cut_50_n2o.png\n"},"children":[],"key":"HTfoLBfJ75"},{"type":"output"